# Telegram Bot Token - Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=tu_token_aqui

# IDs de usuario de Telegram permitidos, separados por comas
TELEGRAM_ALLOWED_USER_IDS=tu_id_aqui

# AI API Keys (at least one is required)
# Get from https://console.groq.com
GROQ_API_KEY=tu_token_aqui

# Get from https://openrouter.ai
OPENROUTER_API_KEY=tu_token_aqui

# Optional: Ollama local instance
OLLAMA_URL=http://localhost:11434

# Búsqueda web (Tavily) - https://tavily.com
TAVILY_API_KEY=tu_token_aqui

# Lectura de URLs (Firecrawl) - https://firecrawl.dev
FIRECRAWL_API_KEY=tu_token_aqui

# Firebase Admin - variables individuales
FIREBASE_PROJECT_ID=tu_token_aqui
FIREBASE_CLIENT_EMAIL=tu_token_aqui
FIREBASE_PRIVATE_KEY=tu_token_aqui

# Firebase Admin - alternativa: JSON completo del service account en base64
# (evita problemas con \n en la private key; si se define, tiene prioridad sobre las 3 de arriba)
FIREBASE_SERVICE_ACCOUNT_B64=tu_token_aqui

# Environment
NODE_ENV=production
PORT=8080

# URL pública del servicio (Cloud Run la asigna) — usada para registrar el webhook de Telegram
WEBHOOK_URL=https://tu-servicio.run.app

# ── H1 (v5.1) — Secretaria ejecutiva ──

# Único user_id de Telegram autorizado (allowlist, C1). Distinto de TELEGRAM_ALLOWED_USER_IDS
# de arriba (plural, sin uso en el código — dead var documentada en el handoff del proyecto).
TELEGRAM_ALLOWED_USER_ID=tu_id_aqui

# OAuth 2.0 de Google (Gmail/Calendar/Tasks) — Desktop app, proyecto en modo "Testing" a
# propósito (ver ítem 88 del system prompt v5.1). Se generan con scripts/oauth-setup.js.
GOOGLE_OAUTH_CLIENT_ID=tu_id_aqui
GOOGLE_OAUTH_CLIENT_SECRET=tu_secreto_aqui
GOOGLE_OAUTH_REFRESH_TOKEN=tu_refresh_token_aqui

# Secreto compartido con Cloud Scheduler para el endpoint POST /cron/daily-brief (aviso de las 9hs)
CRON_SECRET_TOKEN=tu_secreto_aqui
